# Copy to gali/.env and fill in. If gali/.env does not exist, the server reads
# the workspace-root .env instead. Both are gitignored.

# ── Required ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Make one with: openssl rand -hex 32
# Use the same value for VITE_GALI_HTTP_TOKEN in gali/ui/.env.local.
GALI_HTTP_SECRET=
