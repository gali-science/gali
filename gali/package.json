{
  "name": "gali",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "architecture:check": "depcruise --config .dependency-cruiser.cjs shared src ui/src ui/api scripts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc6 -b",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm --dir ui typecheck && pnpm test && pnpm --dir ui test && pnpm architecture:check && pnpm --dir ui build && pnpm --dir ui test:e2e",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@embedpdf/pdfium": "2.15.1",
    "@openai/codex": "0.163.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.1.1",
    "@types/yauzl": "^3.4.0",
    "dependency-cruiser": "^18.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "undici@7": "^7.30.1",
      "vite": "^8.3.5",
      "nanoid@3": "^3.3.20",
      "source-map-js": "^1.2.2",
      "postcss": "^8.5.31"
    }
  }
}
