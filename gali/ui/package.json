{
  "name": "gali-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc6 -b && vite build",
    "sandbox-release:publish": "node scripts/publish-sandbox-release.mjs",
    "typecheck": "tsc6 -b",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/react": "^6.15.1",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-annotation": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-search": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-tiling": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "@vercel/global-config": "^1.5.1",
    "@vercel/node": "^5.9.3",
    "@vercel/sandbox": "3.9.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.4",
    "postgres": "^3",
    "react": "^19.2.7",
    "react-arborist": "^3.15.0",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "undici@7": "^7.30.1",
      "vite": "^8.3.5",
      "nanoid@3": "^3.3.20",
      "source-map-js": "^1.2.2",
      "postcss": "^8.5.31"
    }
  }
}
