# Local Vite → a running Gali server, proxied with its HTTP secret (do not commit real values)
VITE_GALI_HTTP_URL=
VITE_GALI_HTTP_TOKEN=
VITE_GALI_DEV_AUTH_BYPASS=1

# Production / Vercel build: enable HTTP bridge (also set in .env.production)
VITE_GALI_HTTP=1
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk server verification. CLERK_JWT_KEY is the PEM public key from the
# Clerk dashboard; use literal \n escapes when the environment only accepts one line.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5178,https://your-app.vercel.app
CLERK_ALLOWED_EMAIL_DOMAINS=example.com
CLERK_ALLOWED_EMAILS=

# Vercel serverless BFF (Project Settings → Environment Variables)
# On Vercel the Sandbox SDK authenticates with the deployment's OIDC token;
# locally, `vercel env pull` writes VERCEL_OIDC_TOKEN. GALI_SANDBOX_IMAGE is the
# image `sandboxes` publishes, e.g. vcr.vercel.com/<team>/<project>/gali-starter:v1.
GALI_SANDBOX_IMAGE=
TOGETHER_API_KEY=
OPENAI_API_KEY=
GALI_MODEL_GATEWAY_SECRET=
GALI_SANDBOX_HTTP_MASTER_KEY=
GALI_MODEL_GATEWAY_URL=https://your-app.vercel.app/api/model/v1
GALI_TELEMETRY_SECRET=
GALI_CREDENTIAL_MASTER_KEY=
# Control-plane Postgres: accounts + which sandbox each one owns (see
# api/_lib/db/schema.ts). Railway URL in Production/Preview; for local dev,
# `docker compose up -d` in this directory and use the URL below.
DATABASE_URL=postgresql://gali:gali@localhost:5432/gali_control

# Tokens for sleep and notification callbacks are minted per sandbox from
# GALI_MODEL_GATEWAY_SECRET. No shared callback secret is exposed to sandboxes.
GALI_SLEEP_URL=https://your-app.vercel.app/api/sandbox?op=sleep